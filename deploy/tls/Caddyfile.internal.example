# Dedicated deployment instance; keep storage and CA persistent. Distribute only
# its root certificate to Gateway. Never expose the root key to application roles.
{
    admin unix//run/code-platform-tls/caddy-admin.sock
    auto_https disable_redirects
    skip_install_trust
    storage file_system {
        root /var/lib/code-platform-tls/caddy
    }
}
https://127.0.0.1:28950 {
    bind 127.0.0.1
    tls internal
    reverse_proxy 127.0.0.1:28949
}
# Cross-host: replace the site with the private DNS name and bind address;
# publish only the TLS port, firewall callers, and configure the Gateway CA.
# The account process must share the proxy's namespace for loopback upstream.
