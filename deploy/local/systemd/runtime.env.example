# Operator-owned paths; no credentials belong in this file or the repository.
LOCAL_PYTHON=/absolute/path/to/platform/.venv/bin/python
PYTHONPATH=/absolute/path/to/platform
LOCAL_WEB_DIST=/absolute/path/to/platform/jiuwenswarm/channels/web/frontend/dist
JIUWENSWARM_DATA_DIR=/absolute/path/to/existing/data
JIUWENSWARM_CONFIG_DIR=/absolute/path/to/existing/data/config
JIUWENSWARM_HOME=/absolute/path/to/existing/home
JIUWENSWARM_CONFIG_URL=off
CODE_PLATFORM_LOCAL_SYNC_CONFIG=/absolute/path/to/private/local-cloud.json
LOCAL_AGENT_PORT=29013
LOCAL_GATEWAY_PORT=29010
LOCAL_WEB_PORT=29011
LOCAL_AGENT_URL=ws://127.0.0.1:29013
LOCAL_GATEWAY_URL=http://127.0.0.1:29010
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=29012
AGENT_SERVER_HOST=127.0.0.1
