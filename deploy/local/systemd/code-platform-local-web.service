[Unit]
Description=Code-platform local web
PartOf=code-platform-local.target
After=code-platform-local-gateway.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
WorkingDirectory=%h
EnvironmentFile=%h/.config/code-platform/local/runtime.env
ExecStart=/usr/bin/env ${LOCAL_PYTHON} -P -m jiuwenswarm.channels.web.app_web --host 127.0.0.1 --port ${LOCAL_WEB_PORT} --proxy-target ${LOCAL_GATEWAY_URL} --dist ${LOCAL_WEB_DIST}
Restart=always
RestartSec=3
TimeoutStopSec=30
KillMode=control-group
UMask=0077
StandardOutput=journal
StandardError=journal
