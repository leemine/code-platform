# Operator-owned 0600 EnvironmentFile. Replace paths and digest before use.
DOCKER_UPSTREAM=/var/run/docker.sock
WORKSPACE_ROOT=/srv/code-platform/workspaces
WORKSPACE_NAME_PATTERN=env_[a-f0-9]{32}
PRIVATE_LOG_ROOT=/srv/code-platform/private-logs
SHARED_LOG_DIR=/var/log/yuanrong/current-runtime
AGENT_IMAGE=sha256:REPLACE_WITH_VERIFIED_IMAGE_DIGEST
AGENT_USER=agentos
AGENT_UID=1000
